{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "automerge": false
    },
    {
      "matchManagers": ["cargo"],
      "automerge": false
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "automerge": false
    }
  ]
}
